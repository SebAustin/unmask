# Featherless API key (https://featherless.ai) — never commit the real value
FEATHERLESS_API_KEY=
# Model IDs (confirm with: curl -H "Authorization: Bearer $FEATHERLESS_API_KEY" https://api.featherless.ai/v1/models)
VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
ANALYSIS_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Set to 1 to use the deterministic mock model (tests / offline demo)
AI_MOCK=0
